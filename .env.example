# LLM provider: "bedrock" (default) or "litellm"
FINGUARD_LLM_PROVIDER=bedrock

# AWS / Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_MODEL_CLASSIFIER=
BEDROCK_MODEL_RISK=
BEDROCK_MODEL_REPORT=

# AI Gateway (LiteLLM Proxy) — used when FINGUARD_LLM_PROVIDER=litellm
LITELLM_API_BASE=
LITELLM_TOKEN=
LITELLM_KEY_ALIAS=future-minds-013
LITELLM_BUDGET_USD=6.54
LITELLM_MODEL_CLASSIFIER=bedrock-anthropic-claude-haiku-4-5
LITELLM_MODEL_RISK=bedrock-anthropic-claude-sonnet-4-5
LITELLM_MODEL_REPORT=bedrock-anthropic-claude-sonnet-4-5

# Development/demo mode. true = no AWS calls; deterministic mock responses.
FINGUARD_MOCK_LLM=true

# Batch concurrency
FINGUARD_MAX_CONCURRENCY=5

# Paths
FINGUARD_POLICY_PATH=data/KS_POLITICA_INTERNA.pdf
FINGUARD_DATASET_PATH=data/dataset.csv
CLAUDE_CONFIG_DIR=claude